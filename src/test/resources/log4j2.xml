<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="trace">
    <Appenders>

        <!-- Console Appender with Color -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%highlight{[%d{yyyy-MM-dd HH:mm:ss}] [%t] %-5p %c{1}:%L - %m%n}
                                     {FATAL=red bright, ERROR=red, WARN=yellow, INFO=green, DEBUG=cyan}"/>
        </Console>

        <!-- File Appender -->
        <File name="FileLogger" fileName="logs/test-log.log" append="true">
            <PatternLayout pattern="[%d{yyyy-MM-dd HH:mm:ss}] [%t] %-5p %c{1}:%L - %m%n"/>
        </File>

    </Appenders>

    <Loggers>
        <!-- Capture DEBUG and higher for your testcases package -->
        <Logger name="testcases" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileLogger"/>
        </Logger>

        <!-- Root logger to capture all other logs at DEBUG level -->
        <Root level="debug">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileLogger"/>
        </Root>
    </Loggers>
</Configuration>

